FROM ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends build-essential autoconf automake libtool pkg-config bsdmainutils python3 ca-certificates curl libssl-dev libevent-dev libboost-system-dev libboost-filesystem-dev libboost-chrono-dev libboost-program-options-dev libboost-test-dev libboost-thread-dev qtbase5-dev qttools5-dev qttools5-dev-tools libprotobuf-dev protobuf-compiler libqrencode-dev libdbus-1-dev && rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=ca_bundle if [ -r /run/secrets/ca_bundle ]; then export CURL_CA_BUNDLE=/run/secrets/ca_bundle; fi && cd /tmp && curl -fsSL https://download.oracle.com/berkeley-db/db-4.8.30.NC.tar.gz -o bdb.tar.gz && echo '12edc0df75bf9abd7f82f821795bcee50f42cb2e5f76a6a281b85732798364ef  bdb.tar.gz' | sha256sum -c - && tar xf bdb.tar.gz && cd db-4.8.30.NC && sed -i 's/__atomic_compare_exchange/__atomic_compare_exchange_db/g;s/atomic_init/atomic_init_db/g' dbinc/atomic.h mp/mp_region.c mp/mp_mvcc.c mp/mp_fget.c mutex/mut_method.c mutex/mut_tas.c && cd build_unix && ../dist/configure --prefix=/opt/db4 --enable-cxx --disable-shared --with-pic --disable-replication && make -j4 libdb_cxx-4.8.a libdb-4.8.a && make install_lib install_include && rm -rf /tmp/db-4.8.30.NC /tmp/bdb.tar.gz
RUN --mount=type=secret,id=ca_bundle if [ -r /run/secrets/ca_bundle ]; then export CURL_CA_BUNDLE=/run/secrets/ca_bundle; fi && cd /tmp && curl -fsSL https://github.com/JuliaMath/openlibm/archive/refs/tags/v0.8.7.tar.gz -o openlibm.tar.gz && echo 'e328a1d59b94748b111e022bca6a9d2fc0481fb57d23c87d90f394b559d4f062  openlibm.tar.gz' | sha256sum -c - && mkdir openlibm && tar xf openlibm.tar.gz -C openlibm --strip-components=1 && cd openlibm && make -j4 && make prefix=/usr/local install && ldconfig && rm -rf /tmp/openlibm /tmp/openlibm.tar.gz
